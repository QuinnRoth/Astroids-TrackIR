.hud-root {
    position: absolute;
    left: 18px;
    top: 18px;
    right: 18px;
    height: 120px;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.hud-plate {
    position: relative;
    width: 320px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgba(5, 10, 18, 0.85);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(110, 220, 255, 0.65);
    border-right-color: rgba(110, 220, 255, 0.65);
    border-bottom-color: rgba(110, 220, 255, 0.65);
    border-left-color: rgba(110, 220, 255, 0.65);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    box-shadow: 0 0 18px rgba(110, 220, 255, 0.35);
    overflow: hidden;
}

.hud-left {
    left: 0;
    top: 0;
    width: 320px;
}

.hud-right {
    right: 0;
    top: 0;
    width: 320px;
    align-items: flex-end;
}

.plate-fill {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(154, 208, 224, 0.1);
    box-shadow: 0 0 22px rgba(154, 208, 224, 0.1);
}

.hud-title {
    position: relative;
    -unity-font-definition: url("project://database/Assets/Fonts/Evil_Empire.otf?fileID=12800000&guid=0e60124b4f87b0d46ab6b79b77c270d9&type=3#Evil_Empire");
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(230, 245, 255);
    -unity-text-outline-color: rgba(110, 220, 255, 0.75);
    -unity-text-outline-width: 0.16;
    text-shadow: 0 0 10px rgba(110, 220, 255, 0.45);
    margin-bottom: 10px;
}

.hud-score {
    position: relative;
    -unity-font-definition: url("project://database/Assets/Fonts/Evil_Empire.otf?fileID=12800000&guid=0e60124b4f87b0d46ab6b79b77c270d9&type=3#Evil_Empire");
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(240, 250, 255);
    -unity-text-outline-color: rgba(110, 220, 255, 0.85);
    -unity-text-outline-width: 0.18;
    text-shadow: 0 0 14px rgba(110, 220, 255, 0.55), 0 0 26px rgba(170, 245, 255, 0.25);
    letter-spacing: 2px;
}

.hud-segments {
    position: relative;
    display: flex;
    flex-direction: row;
}

.segment {
    height: 18px;
    flex-grow: 1;
    background-color: rgba(55, 198, 241, 0.93);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(110, 220, 255, 0.55);
    border-right-color: rgba(110, 220, 255, 0.55);
    border-bottom-color: rgba(110, 220, 255, 0.55);
    border-left-color: rgba(110, 220, 255, 0.55);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
    box-shadow: 0 0 12px rgba(131, 166, 177, 0.2);
    margin-right: 8px;
}

.segment-empty {
    background-color: rgba(240, 250, 255, 0.12);
}

.segment-danger {
    background-color: rgba(255, 0, 0, 0.95);
    box-shadow: 0 0 18px rgba(255, 0, 0, 0.35);
}

.segment-good {
    background-color: rgba(0, 220, 73, 0.95);
    box-shadow: 0 0 18px rgba(0, 220, 120, 0.35);
}

.segment-warn {
    background-color: rgba(255, 217, 0, 0.95);
    box-shadow: 0 0 18px rgba(255, 215, 0, 0.25);
}

.hud-scorePlate {
    align-items: flex-end;
}

.unity-progress-bar_container {
}

.unity-progress-bar_progress {
    background-color: rgb(255, 255, 255);
}

.unity-progress-bar_background {
}

#ProgressBarContainer > .unity-progress-bar > #unity-progress-bar > .unity-progress-bar__background {
    background-color: rgb(173, 173, 173);
}

#ProgressBarContainer > .unity-progress-bar > #unity-progress-bar > .unity-progress-bar__background > .unity-progress-bar__progress {
    background-color: rgb(0, 132, 183);
}
