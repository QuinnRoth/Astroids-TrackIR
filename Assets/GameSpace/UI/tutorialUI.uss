:root {
}

.unity-progress-bar {
    background-color: rgb(164, 0, 0);
    position: relative;
    right: 0;
    left: 0;
    top: 0;
    bottom: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.unity-progress-bar__progress {
    background-color: rgb(255, 255, 255);
    position: absolute;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    width: auto;
    height: auto;
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-right-radius: 11px;
    border-bottom-left-radius: 11px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.unity-progress-bar__background {
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
    border-bottom-left-radius: 16px;
    -unity-background-scale-mode: stretch-to-fill;
    border-left-color: rgb(0, 191, 254);
    border-right-color: rgb(0, 191, 254);
    border-top-color: rgb(0, 191, 254);
    border-bottom-color: rgb(0, 191, 254);
    position: relative;
    background-color: rgba(50, 78, 87, 0.85);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

VisualElement > #GroupBox > #ToggleGroup > .unity-toggle:checked > .unity-toggle__input > .unity-toggle__checkmark {
    background-image: none;
    background-color: rgb(14, 169, 220);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

VisualElement > #GroupBox > #ToggleGroup > .unity-toggle > .unity-toggle__input > #unity-checkmark {
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
}

VisualElement > #GroupBox > #ToggleGroup > .unity-toggle > .unity-toggle__label {
    display: none;
}

VisualElement > #GroupBox > #ToggleGroup2 > #Bomb > .unity-toggle__input > .unity-toggle__checkmark {
    background-image: url("project://database/Assets/Fonts/Kenney%20Space.ttf?fileID=2800000&guid=96efaa75234da0c4391eb9d2d09282f2&type=3#Font Texture");
    background-color: rgb(255, 255, 255);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-slice-left: 0;
    -unity-slice-top: 0;
    -unity-slice-right: 0;
    -unity-slice-bottom: 0;
    background-position-x: center;
    -unity-slice-type: sliced;
    background-repeat: no-repeat no-repeat;
    background-position-y: bottom 2px;
    background-size: 130% 100%;
}

VisualElement > #GroupBox > #ToggleGroup2 > #Heal > .unity-toggle__input > .unity-toggle__checkmark {
