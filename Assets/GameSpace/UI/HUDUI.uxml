<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/GameSpace/UI/HUDUI.uss?fileID=7433441132597879392&amp;guid=d78692d4fd6eb8d43936ad90e23c5979&amp;type=3#HUDUI"/>
    <ui:VisualElement class="hud-root">
        <ui:VisualElement class="hud-plate">
            <ui:VisualElement class="plate-fill"/>
            <ui:Label text="Health" class="hud-title" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Spaceport_2006.otf?fileID=12800000&amp;guid=4665f3a764435ab458073afb5589a827&amp;type=3#Spaceport_2006&quot;); height: 23px;"/>
            <ui:VisualElement name="healthSegments" class="hud-segments"/>
        </ui:VisualElement>
        <ui:VisualElement class="hud-plate hud-scorePlate">
            <ui:VisualElement class="plate-fill"/>
            <ui:Label name="scoreLabel" text="Score 000000" class="hud-score" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Spaceport_2006.otf?fileID=12800000&amp;guid=4665f3a764435ab458073afb5589a827&amp;type=3#Spaceport_2006&quot;); font-size: 22px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:Image style="position: absolute;"/>
    <ui:VisualElement name="ProgressBarContainer" style="flex-grow: 1; align-self: auto; align-content: auto; justify-content: flex-end;">
        <ui:ProgressBar value="22" title="" name="heatBar" style="align-content: flex-start; justify-content: flex-start; width: 40%; align-self: center;"/>
    </ui:VisualElement>
    <ui:VisualElement name="Gauge" class="tachometer" style="width: 47px; top: auto; bottom: 11%;">
        <ui:VisualElement class="tachometer-frame" style="background-color: rgba(2, 8, 16, 0.57);"/>
        <ui:VisualElement name="VisualElement" class="tachometer-glow" style="color: rgba(27, 27, 27, 0);">
            <ui:VisualElement name="Fill" class="tachometer-fill" style="bottom: 0; padding-bottom: 0; margin-bottom: 0; flex-grow: 1; height: 100%; left: 0; right: 0;"/>
        </ui:VisualElement>
        <ui:Label text="SPEED" class="tachometer-label" style="top: auto; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Spaceport_2006.otf?fileID=12800000&amp;guid=4665f3a764435ab458073afb5589a827&amp;type=3#Spaceport_2006&quot;); -unity-font-style: bold; -unity-text-outline-width: 0; text-shadow: 0 0 10px rgba(110, 220, 255, 0.63); bottom: -29px;"/>
    </ui:VisualElement>
</ui:UXML>
