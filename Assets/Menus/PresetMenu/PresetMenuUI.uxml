<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Menus/MenuStyle.uss?fileID=7433441132597879392&amp;guid=1bda5f1b0a660b842850d9bec8f30d82&amp;type=3#MenuStyle"/>
    <ui:VisualElement name="MenuContainer" class="MenuContainer" style="flex-grow: 1; justify-content: center; align-items: center; flex-direction: row; align-self: center; align-content: flex-start;">
        <ui:VisualElement name="rootPresets" class="SettingsPanel" style="width: 60%; margin-right: 0%; flex-grow: 1; height: 45%; flex-direction: column;">
            <ui:VisualElement name="header" style="width: auto; height: auto; justify-content: center; align-items: center; align-self: center; margin-bottom: 0;">
                <ui:Label text="Presets" class="SettingsTitle" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Spaceport_2006.otf?fileID=12800000&amp;guid=4665f3a764435ab458073afb5589a827&amp;type=3#Spaceport_2006&quot;); flex-shrink: 1;"/>
            </ui:VisualElement>
            <ui:VisualElement name="content" class="ColorPaletteContent" style="height: auto; width: auto; align-self: center; margin-top: 18px;">
                <ui:VisualElement name="shipSection" class="ColorPaletteSection" style="flex-grow: 1; width: auto;">
                    <ui:VisualElement name="shipSwatches" class="SwatchRow" style="flex-grow: 1; align-content: stretch; align-self: center; justify-content: flex-end; flex-wrap: wrap; align-items: center; white-space: normal; flex-direction: row; width: auto;">
                        <ui:Button name="shipPreset0" class="ColorSwatch ShipSwatch presets quickPresets" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;">
                            <ui:VisualElement name="leftColor" class="presetLeftColor" style="flex-grow: 1; background-color: rgb(0, 75, 178);"/>
                            <ui:VisualElement name="rightColor" class="presetRightColor" style="flex-grow: 1; background-color: rgb(128, 128, 128);"/>
                            <ui:Label text="OptiTrack" class="presetTitles" style="color: rgb(240, 250, 255);"/>
                        </ui:Button>
                        <ui:Button name="shipPreset1" class="ColorSwatch ShipSwatch presets quickPresets" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;">
                            <ui:VisualElement name="leftColor" class="presetLeftColor" style="flex-grow: 1; background-color: rgb(0, 75, 178);"/>
                            <ui:VisualElement name="rightColor" class="presetRightColor" style="flex-grow: 1; background-color: rgb(128, 128, 128);"/>
                            <ui:Label text="Active IO" class="presetTitles" style="color: rgb(240, 250, 255);"/>
                        </ui:Button>
                        <ui:Button name="shipPreset2" class="ColorSwatch ShipSwatch presets quickPresets" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;">
                            <ui:VisualElement name="leftColor" class="presetLeftColor" style="flex-grow: 1; background-color: rgb(0, 75, 178);"/>
                            <ui:VisualElement name="rightColor" class="presetRightColor" style="flex-grow: 1; background-color: rgb(128, 128, 128);"/>
                            <ui:Label text="TrackIR" class="presetTitles" style="color: rgb(240, 250, 255);"/>
                        </ui:Button>
                        <ui:Button name="shipPreset3" class="ColorSwatch ShipSwatch presets quickPresets" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;">
                            <ui:VisualElement name="leftColor" class="presetLeftColor" style="flex-grow: 1; background-color: rgb(0, 75, 178);"/>
                            <ui:VisualElement name="rightColor" class="presetRightColor" style="flex-grow: 1; background-color: rgb(128, 128, 128);"/>
                            <ui:Label text="PLANAR" class="presetTitles" style="color: rgb(240, 250, 255);"/>
                        </ui:Button>
                        <ui:Button name="shipPreset4" class="ColorSwatch ShipSwatch presets quickPresets" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;">
                            <ui:VisualElement name="leftColor" class="presetLeftColor" style="flex-grow: 1; background-color: rgb(0, 75, 178);"/>
                            <ui:VisualElement name="rightColor" class="presetRightColor" style="flex-grow: 1; background-color: rgb(128, 128, 128);"/>
                            <ui:Label text="Classic" class="presetTitles" style="color: rgb(240, 250, 255);"/>
                        </ui:Button>
                        <ui:Button name="shipPreset5" class="ColorSwatch ShipSwatch presets quickPresets" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;">
                            <ui:VisualElement name="leftColor" class="presetLeftColor" style="flex-grow: 1; background-color: rgb(0, 75, 178);"/>
                            <ui:VisualElement name="rightColor" class="presetRightColor" style="flex-grow: 1; background-color: rgb(128, 128, 128);"/>
                            <ui:Label text="Tron" class="presetTitles" style="color: rgb(240, 250, 255);"/>
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="NavButtons" style="width: auto; flex-direction: row; justify-content: center; align-items: center; margin-top: 16px; align-content: flex-start; align-self: center;">
                <ui:Button name="backButton" class="MainMenuButton" style="width: 260px; margin-right: 7%; margin-bottom: 19px;">
                    <ui:VisualElement class="ButtonFill"/>
                    <ui:VisualElement class="ButtonSheen"/>
                    <ui:Label text="Back" class="ButtonText" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Spaceport_2006.otf?fileID=12800000&amp;guid=4665f3a764435ab458073afb5589a827&amp;type=3#Spaceport_2006&quot;); font-size: 34px;"/>
                </ui:Button>
                <ui:Button name="doneButton" class="MainMenuButton" style="width: 260px; margin-left: 7%; margin-bottom: 19px;">
                    <ui:VisualElement class="ButtonFill"/>
                    <ui:VisualElement class="ButtonSheen"/>
                    <ui:Label text="Next" class="ButtonText" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Spaceport_2006.otf?fileID=12800000&amp;guid=4665f3a764435ab458073afb5589a827&amp;type=3#Spaceport_2006&quot;); font-size: 34px;"/>
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
